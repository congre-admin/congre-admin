{
  "name": "congre-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://congre-admin.github.io",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');const p='../backend/src/api.gs';const d='public/api/api.gs';if(fs.existsSync(p)){fs.mkdirSync('public/api',{recursive:true});fs.copyFileSync(p,d);console.log('✓ api.gs synced')}\"",
    "prebuild": "node -e \"const fs=require('fs');const p='../backend/src/api.gs';const d='public/api/api.gs';if(fs.existsSync(p)){fs.mkdirSync('public/api',{recursive:true});fs.copyFileSync(p,d);console.log('✓ api.gs synced')}\"",
    "dev": "vite",
    "dev:spa": "node dev-server.js",
    "build": "vite build --config vite.config.ts",
    "postbuild": "node -e \"const fs=require('fs');fs.copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "clasp:push": "cd ../backend && npx @google/clasp push",
    "clasp:pull": "cd ../backend && npx @google/clasp pull",
    "clasp:deploy": "cd ../backend && npx @google/clasp deploy",
    "clasp:open": "cd ../backend && npx @google/clasp open",
    "clasp:status": "cd ../backend && npx @google/clasp status",
    "clasp:versions": "cd ../backend && npx @google/clasp versions",
    "clasp:list": "cd ../backend && npx @google/clasp list"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@tanstack/query-persist-client-core": "^5.51.0",
    "@tanstack/query-sync-storage-persister": "^5.51.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.96.0",
    "@tanstack/react-table": "^8.20.0",
    "idb-keyval": "^6.2.1",
    "jose": "^5.6.0",
    "jsonata": "^2.0.0",
    "otpauth": "^9.2.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.0.1"
  }
}
